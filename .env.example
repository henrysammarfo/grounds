# .env.example — GROUNDS

# Never commit real keys. Do not paste keys into chat — put them here locally.

# AgentRouter (preferred — see aftercut/docs/KEYS_SETUP.md)
# https://agentrouter.org/console/token
AGENT_ROUTER_API_KEY=
AGENT_ROUTER_OPENAI_BASE=https://agentrouter.org/v1
# Live model IDs on Henry's account: gpt-5.6-sol · deepseek-v4-flash · claude-opus-5
GROUNDS_MODEL=gpt-5.6-sol

# Optional native OpenAI (not required if AgentRouter is set)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional price overrides (USD per 1M tokens) for cost estimates
# GROUNDS_PRICE_IN_PER_M=0.15
# GROUNDS_PRICE_OUT_PER_M=0.60

# Human gate stopwatch (interactive approve/deny)
# GROUNDS_INTERACTIVE_GATE=1

# Live research
TAVILY_API_KEY=
TINYFISH_API_KEY=

# Lovable / Supabase (existing app shell)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Local product film / contest walkthrough — bypass Supabase for dashboard routes
# VITE_GROUNDS_DEMO=1
